<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/gov_blue_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shield"
            android:contentDescription="Emblem" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtHeaderOfficer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunita Rao (Inspector)"
                android:textColor="@color/slate_300"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSyncBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/emerald_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Online"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/gov_blue_primary"
            android:text="Switch"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. GPS GEOFENCE RADAR BANNER -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGeofenceBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/emerald_bg"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgGeofenceIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check"
                            android:contentDescription="Geofence Icon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtGeofenceTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/geofence_verified"
                                android:textColor="@color/emerald_dark"
                                android:textStyle="bold"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtRadarStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35m from facility boundary • Verified On-site"
                                android:textColor="@color/emerald_dark"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnRefreshGps"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:backgroundTint="@color/emerald_dark"
                            android:text="@string/btn_refresh_gps"
                            android:textColor="@color/white"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#15000000"
                        android:padding="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDeviceCoords"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DEVICE: 28.5675° N, 77.1736° E"
                            android:textColor="@color/slate_900"
                            android:fontFamily="monospace"
                            android:textSize="9sp" />

                        <CheckBox
                            android:id="@+id/chkSimulateOnsite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/simulate_onsite_label"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. FACILITY SELECTOR (LOCKED TO ASSIGNED) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Assigned Facility to Audit:"
                            android:textColor="@color/slate_900"
                            android:textStyle="bold"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnSyncAssignments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_card"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_marginEnd="6dp"
                            android:text="🔄 Sync Web"
                            android:textColor="@color/gov_blue_primary"
                            android:textStyle="bold"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/txtFacilityCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/gov_blue_bg"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="1 Assigned (Locked)"
                            android:textColor="@color/gov_blue_primary"
                            android:textStyle="bold"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerAuditFacility"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_card" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtAuditTypeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/rose_bg"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="SURPRISE AUDIT"
                            android:textColor="@color/rose_dark"
                            android:textStyle="bold"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/txtAuditId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="INSP-2026-DL001"
                            android:textColor="@color/slate_500"
                            android:fontFamily="monospace"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtFacilityName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Snehalaya Senior Citizens Home"
                        android:textColor="@color/slate_900"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtFacilityScheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scheme: AVYAY (Atal Vayo Abhyuday Yojana)"
                        android:textColor="@color/gov_blue_primary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtFacilityLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sector 4, R.K. Puram, New Delhi • Cap: 88/100"
                        android:textColor="@color/slate_500"
                        android:textSize="10sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. STATUTORY INSPECTION CHECKLIST (5 RUBRICS) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Statutory Inspection Checklist"
                        android:textColor="@color/slate_900"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Rubric 1: Infra -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rubric_infra"
                            android:textColor="@color/slate_700"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/valInfra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekInfra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="85"
                        android:layout_marginBottom="6dp" />

                    <!-- Rubric 2: Hygiene -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rubric_hygiene"
                            android:textColor="@color/slate_700"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/valHygiene"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90%"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekHygiene"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="90"
                        android:layout_marginBottom="6dp" />

                    <!-- Rubric 3: Food -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rubric_food"
                            android:textColor="@color/slate_700"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/valFood"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekFood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="80"
                        android:layout_marginBottom="6dp" />

                    <!-- Rubric 4: Medical -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rubric_medical"
                            android:textColor="@color/slate_700"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/valMedical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekMedical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="85"
                        android:layout_marginBottom="6dp" />

                    <!-- Rubric 5: Attendance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rubric_attendance"
                            android:textColor="@color/slate_700"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/valAttendance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90%"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekAttendance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="90"
                        android:layout_marginBottom="10dp" />

                    <!-- Total Score Summary Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/gov_blue_bg"
                        android:padding="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_compliance_label"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtTotalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="86 / 100 (GRADE A)"
                            android:textColor="@color/gov_blue_dark"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. CAMERA PHOTO CAPTURE & WATERMARKED EVIDENCE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/evidence_section_title"
                            android:textColor="@color/slate_900"
                            android:textStyle="bold"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Evidence Attached"
                            android:textColor="@color/emerald_dark"
                            android:textStyle="bold"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Camera Trigger Buttons Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCaptureKitchen"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/slate_100"
                            android:text="@string/btn_capture_kitchen"
                            android:textColor="@color/slate_800"
                            android:textSize="8sp" />

                        <Button
                            android:id="@+id/btnCaptureDorms"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="@color/slate_100"
                            android:text="@string/btn_capture_dorms"
                            android:textColor="@color/slate_800"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCaptureMedical"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/slate_100"
                            android:text="@string/btn_capture_medical"
                            android:textColor="@color/slate_800"
                            android:textSize="8sp" />

                        <Button
                            android:id="@+id/btnCaptureSanitation"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="@color/slate_100"
                            android:text="@string/btn_capture_sanitation"
                            android:textColor="@color/slate_800"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Horizontal Evidence Gallery -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerEvidenceGallery"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. DUAL DIGITAL SIGNATURES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_signatures_title"
                        android:textColor="@color/slate_900"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSignInsp"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:backgroundTint="@color/emerald_bg"
                            android:text="@string/sig_inspector"
                            android:textColor="@color/emerald_dark"
                            android:textStyle="bold"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnSignHead"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="@color/emerald_bg"
                            android:text="@string/sig_head"
                            android:textColor="@color/emerald_dark"
                            android:textStyle="bold"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. SUBMISSION BUTTONS -->
            <Button
                android:id="@+id/btnSubmitCloud"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/gov_blue_dark"
                android:text="@string/btn_submit_cloud"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSaveOffline"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/slate_300"
                android:text="@string/btn_save_offline"
                android:textColor="@color/slate_800"
                android:textSize="11sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
