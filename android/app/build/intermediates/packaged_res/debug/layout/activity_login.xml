<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Ministry Emblem / Shield Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgHeaderEmblem"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="Emblem" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ministry_title"
                android:textColor="@color/gov_blue_dark"
                android:textStyle="bold"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/department_subtitle"
                android:textColor="@color/slate_500"
                android:textSize="11sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/txtServerConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🌐 Server: Configure (Tap to change)"
                    android:textColor="@color/slate_700"
                    android:fontFamily="monospace"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:text="⚡ Ping"
                    android:textSize="9sp"
                    android:backgroundTint="@color/gov_blue_dark"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="● Checking connection..."
                android:textColor="@color/slate_500"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Officer Selection Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_inspector_prompt"
            android:textColor="@color/slate_700"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerOfficerSelect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Selected Officer Profile & Assignment Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtOfficerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunita Rao"
                            android:textColor="@color/slate_900"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtOfficerDesignation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Senior Field Inspection Officer • Delhi"
                            android:textColor="@color/slate_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtOfficerStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/amber_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="Assigned Audit"
                        android:textColor="@color/saffron_dark"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Assigned Facility Notice Box -->
                <LinearLayout
                    android:id="@+id/layoutAssignmentNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/amber_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ ASSIGNED UNANNOUNCED AUDIT:"
                        android:textColor="@color/rose_dark"
                        android:textStyle="bold"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtAssignedFacilityName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Snehalaya Senior Citizens Home"
                        android:textColor="@color/slate_900"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtAssignedFacilityScheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scheme: AVYAY • Sector 4, New Delhi"
                        android:textColor="@color/gov_blue_primary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GovCloud SSO PIN Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sso_pin_label"
            android:textColor="@color/slate_700"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editSsoPin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_card"
            android:inputType="numberPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="123456"
            android:textColor="@color/slate_900"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Login Action Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/gov_blue_dark"
            android:text="@string/btn_login"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Protected by PostGIS Geofence, AES-256-GCM &amp; 5-Tier RBAC"
            android:textColor="@color/slate_500"
            android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
