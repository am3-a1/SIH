<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_900"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="Emblem" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MoSJE HANDHELD CLIENT"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OAuth2 SSO Gateway"
                    android:textColor="@color/blue_200"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🟢 Online"
                android:textColor="@color/emerald_300"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Server Configuration Pill -->
        <LinearLayout
            android:id="@+id/layoutServerConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txtServerConfig"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌐 http://192.168.1.111:3000"
                android:textColor="@color/slate_300"
                android:fontFamily="monospace"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnTestConnection"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="@color/slate_700"
                android:text="Config"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Center Emblem & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_badge_amber"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgHeaderEmblem"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="Emblem" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Inspector Authentication"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Central Field Surveillance Cadre • GovCloud SSO"
                android:textColor="@color/slate_400"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Officer Selection Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE FIELD INSPECTOR (52 AVAILABLE)"
            android:textColor="@color/slate_400"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerOfficerSelect"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_dark_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Selected Officer Profile & Assignment Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CADRE STATUS"
                    android:textColor="@color/slate_400"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtOfficerStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_amber"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Active Audit Assigned"
                    android:textColor="@color/amber_300"
                    android:textStyle="bold"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtOfficerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunita Rao"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtOfficerDesignation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Senior Field Inspection Officer • Delhi"
                android:textColor="@color/slate_400"
                android:textSize="11sp" />

            <!-- Assigned Facility Notice Box -->
            <LinearLayout
                android:id="@+id/layoutAssignmentNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dark_input"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ STATUTORY AUDIT TARGET (LOCKED):"
                    android:textColor="@color/amber_400"
                    android:textStyle="bold"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtAssignedFacilityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Snehalaya Senior Citizens Home"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtAssignedFacilityScheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="New Delhi, Delhi • AVYAY"
                    android:textColor="@color/blue_200"
                    android:fontFamily="monospace"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Standby Warning Box (if no assignment) -->
            <LinearLayout
                android:id="@+id/layoutStandbyNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dark_input"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Standby Mode - No Active Assignment"
                    android:textColor="@color/slate_300"
                    android:textStyle="bold"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Field auditors are strictly locked to assigned facilities. Dispatch an audit from Dashboard to unlock this officer."
                    android:textColor="@color/slate_400"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- GovCloud SSO PIN Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOVCLOUD AUTHENTICATOR PIN"
            android:textColor="@color/slate_400"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editSsoPin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_dark_input"
            android:inputType="numberPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="123456"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_500"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Login Action Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/blue_600"
            android:text="Unlock Handheld Audit Station"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PostGIS Geofence • AES-256-GCM Cryptographic Enclave"
            android:textColor="@color/slate_500"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
