<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="160dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/slate_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="90dp">

            <ImageView
                android:id="@+id/imgEvidenceThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Evidence Photo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="#D32F2F"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="WATERMARKED"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="7sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@color/slate_800">

            <TextView
                android:id="@+id/txtEvidenceCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kitchen Area"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtEvidenceHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SHA: 8f3a9b1c..."
                android:textColor="@color/emerald_verified"
                android:fontFamily="monospace"
                android:textSize="7sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtEvidenceTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2026-09-12 UTC"
                android:textColor="@color/slate_300"
                android:fontFamily="monospace"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
